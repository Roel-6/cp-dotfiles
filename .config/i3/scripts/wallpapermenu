#!/usr/bin/env bash

# Paths and Theme
ROTHEME="$HOME/.config/rofi/launchers/type-1/style-10.rasi"
FOLDER="$HOME/Pictures/wallpaper"
SCRIPT="$HOME/.config/i3/scripts/walrefresh"

menu() {
    # 1. Choose Backend
    BACKEND=$(printf "wal\ncolorthief\nhaishoku" | rofi -dmenu -theme "$ROTHEME" -theme-str 'entry { placeholder: "Choose backend:"; }')
    [ -z "$BACKEND" ] && exit 0

    # 2. Choose Lightmode
    LIGHTMODE=$(printf "false\ntrue" | rofi -dmenu -theme "$ROTHEME" -theme-str 'entry { placeholder: "Lightmode:"; }')
    [ -z "$LIGHTMODE" ] && exit 0

    # 3. Saturation Input (Text-only Rofi prompt)
    SATURATION=$(rofi -dmenu -theme "$ROTHEME" -theme-str 'entry { placeholder: "Saturation (Default: 0):"; }' -lines 0 < /dev/null)
    ROFI_EXIT=$? # Capture Rofi's exit code immediately

    # If you pressed Escape to cancel, Rofi returns exit code 1
    if [ $ROFI_EXIT -eq 1 ]; then
        exit 0
    fi

    # If you pressed Enter without typing anything, the string is empty
    if [ -z "$SATURATION" ]; then
        SATURATION="0"
    fi

    # Pure Bash Validation: Strictly matches -1.0 to 1.0
    if [[ ! "$SATURATION" =~ ^[-+]?(0(\.[0-9]+)?|1(\.0+)?)$ ]]; then
        exit 1 # Invalid input, exit immediately
    fi

    # 4. Update cache files (ensuring directory exists first)
    # mkdir -p "$HOME/.cache/wal"
    echo "BCKND=\"$BACKEND\"" > "$HOME/.cache/wal/backend.sh"
    echo "LIGHTMD=\"$LIGHTMODE\"" > "$HOME/.cache/wal/lightmode.sh"

    # 5. Launch nsxiv to pick the wallpaper
    if command -v nsxiv >/dev/null 2>&1; then
        CHOICE=$(nsxiv -otb "$FOLDER"/*)
        [ -z "$CHOICE" ] && exit 0
    else
        # Exit if nsxiv is missing
        exit 1
        notify-send "nsxiv isn't installed"
    fi

    # 6. Build the pywal command safely using a Bash array
    wal_args=(-i "$CHOICE" -a 85 -o "$SCRIPT" --backend "$BACKEND" --saturate "$SATURATION")
    
    if [ "$LIGHTMODE" = "true" ]; then
        wal_args+=(-l)
    fi

    # Execute pywal
    wal "${wal_args[@]}"
}

# Handle arguments if passed directly (bypasses the menu)
case "$#" in
    0) menu ;;
    1) wal -i "$1" -o "$SCRIPT" ;;
    2) wal -i "$1" --theme "$2" -o "$SCRIPT" ;;
    *) exit 0 ;;
esac
