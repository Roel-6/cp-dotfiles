// Inspired by Catnap
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        // "source": "~/.config/fastfetch/logo/ascii/wutwut.txt",
        "padding": {"top": 1, "right": 1, "left": 2},
        "color": {
            "1": "0;35"
        },
    },
    "display": {
        "separator": " "
    },
    "modules": [
          "break",
          "break",
         {
            "type": "os",
            "key": "OS   ",
            "keyColor": "31",  // = color1
        },
        {
            "type": "kernel",
            "key": " ├  ",
            "keyColor": "31",
        },
        {
            "type": "packages",
            "format": "{} (pacman)",
            "key": " ├ 󰏖 ",
            "keyColor": "31",  
        },
        {
            "type": "shell",
            "key": " └  ",
            "keyColor": "31", 
        },
        "break",
        {
            "type": "wm",
            "key": "WM   ",
            "keyColor": "magenta", 
        },
        {
            "type": "wmtheme",
            "key": " ├ 󰉼 ",
            "keyColor": "magenta",
        },
        {
            "type": "icons",
            "key": " ├ 󰀻 ",
            "keyColor": "magenta",
        },
        {
            "type": "cursor",
            "key": " ├  ",
            "keyColor": "magenta", 
        },
        {
            "type": "terminal",
            "key": " ├  ",
            "keyColor": "magenta",
        },
        {
            "type": "terminalfont",
            "key": " └  ",
            "keyColor": "magenta", 
        },
        "break",
        {
            "type": "cpu",
            "format": "{name}",
            "key": "CPU",
            "keyColor": "cyan",
        },
        {
            "type": "gpu",
            "format": "{name}",            
            "key": " ├ 󰢮 ",
            "keyColor": "cyan",
        },
        {
            "type": "memory",
            "key": " ├  ",
            "keyColor": "cyan",
        },
        {
            "type": "swap",
            "key": " ├ 󰓡 ",
            "keyColor": "cyan",
        },
        {
            "type": "disk",
            "key": " ├ 󰋊 ",
            "keyColor": "cyan",
        },
        {
            "type": "monitor",
            "format": "{width}x{height}px {refresh-rate} hz",
            "key": " └  ",
            "keyColor": "cyan",
        },
        "break",
        {
            "key": "  {#keys}",
            "type": "colors",
            "symbol": "circle",
            "keyColor": "red",
        },
        ]
}
